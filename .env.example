# ==============================================================================
# UNIVERSAL AI MODEL ROUTER — CONFIGURATION TEMPLATE
# (Template for Other Users / Fresh PC Setup)
# ==============================================================================
# Users should insert their own free/paid API keys below.
# Leave blank or unconfigured to automatically skip to next available provider.

# ── Gateway Port ─────────────────────────────────────────────────────────────
PORT=3000

# ── TIER A: Google Gemini Cloud (Free: https://aistudio.google.com/) ──────────
GEMINI_API_KEY_1=your_gemini_api_key_here
GEMINI_MODEL_1=gemini-2.5-pro

# ── TIER B: OpenCode AI Models (Free: https://opencode.ai/) ───────────────────
OPENCODE_API_KEY=your_opencode_api_key_here

# ── TIER C: Hugging Face Community Endpoints (No Key Required) ────────────────
HF_QWEN_URL=https://g9hnto0u7lvbu837.us-east-2.aws.endpoints.huggingface.cloud/v1/chat/completions
HF_QWEN_MODEL=Qwen/Qwen3.8-27B

# ── TIER D: Local Microservices (Optional) ────────────────────────────────────
# FreeLLM Local Port: 3001
# OmniRoute Local Port: 20128

# ── FALLBACK PROVIDERS (Triggered when primary free tiers fail) ────────────────
# 1. AgentRouter (Claude Opus 4.8)
AGENTROUTER_API_KEY=your_agentrouter_api_key_here
AGENTROUTER_MODEL=claude-opus-4-8

# 2. OpenRouter (Nemotron Ultra Free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# 3. GitHub Models (GPT-4o Mini)
GITHUB_API_KEY=your_github_token_here
GITHUB_MODEL=gpt-4o-mini
